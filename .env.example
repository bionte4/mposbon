# =============================================================================
# BonPOS environment template
# Copy to `.env` then start with Docker Desktop (recommended):
#   npm run compose:desktop
#   → http://localhost:9088
#
# Or production-like ports (80/3000/8080/5432):
#   docker compose up -d --build
#
# Never commit real secrets.
#
# Deployment:
#   DEPLOYMENT_MODE=cloud     → multi-tenant SaaS (shared DB, tenant_id + RLS)
#   DEPLOYMENT_MODE=onprem    → single locked tenant on local/edge hardware
#   On-prem compose overlay:  docker compose -f docker-compose.yml -f docker-compose.onprem.yml up -d
# =============================================================================

# --- Runtime ---
NODE_ENV=production
DEPLOYMENT_MODE=cloud
APP_NAME=BonPOS
# Inside containers APP_PORT is forced to 3000 by compose. This value is for local npm only.
APP_PORT=3001

# Public URLs (decoupled frontend / API — used for CORS allowlist)
# Docker Desktop overlay defaults (docker-compose.desktop.yml):
GATEWAY_PORT=9088
API_HOST_PORT=9300
WEB_HOST_PORT=9080
POSTGRES_HOST_PORT=5433

# Prefer gateway origin when using Docker Desktop
FRONTEND_URL=http://localhost:9088
API_URL=http://localhost:9088
CORS_ORIGINS=http://localhost:9088,http://127.0.0.1:9088,http://localhost:9080,http://127.0.0.1:9080,http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
# Host URLs below are for local npm / GUI tools against published Postgres.
# Compose overrides DATABASE_* inside the api container to use host `postgres`.
DATABASE_MIGRATE_URL=postgresql://bonpos:bonpos@localhost:5433/bonpos?schema=public
DATABASE_URL=postgresql://bonpos_app:bonpos_app@localhost:5433/bonpos?schema=public

POSTGRES_DB=bonpos
POSTGRES_USER=bonpos
POSTGRES_PASSWORD=bonpos
POSTGRES_APP_USER=bonpos_app
POSTGRES_APP_PASSWORD=bonpos_app

# --- Multi-tenancy ---
# Cloud: tenants resolved from Host / JWT / X-Tenant-Slug
# On-prem: this slug is the only allowed tenant (hardware lock)
DEFAULT_TENANT_SLUG=onprem-store
# Optional UUID pin for on-prem after first provision (leave empty to resolve by slug)
DEFAULT_TENANT_ID=

# Host header pattern for SaaS subdomains: {slug}.bonpos.local
TENANT_HOST_BASE=bonpos.local

# --- License (online cloud vs offline on-prem dongle/file) ---
LICENSE_VALIDATION_MODE=online
LICENSE_KEY=
LICENSE_OFFLINE_GRACE_HOURS=72

# Set true on first boot to provision DEFAULT_TENANT_SLUG (safe to re-run; upsert)
RUN_DB_SEED=true
# Dev seed only — stored as scrypt hash (never plaintext in DB)
# Auth
JWT_SECRET=bonpos-dev-jwt-secret-change-me
SEED_SUPERVISOR_PIN=1234

# --- Feature flags ---
# Edge ↔ hub sync (on-prem / async outbox). Optional hub URL for live push.
FEATURE_EDGE_SYNC=true
EDGE_HUB_URL=
FEATURE_HRIS=true
FEATURE_OFFLINE_POS=true

# --- Payments (QRIS) ---
# local = store static/dynamic QR (manual confirm)
# midtrans | xendit = PSP charge + webhook/poll
PAYMENT_PROVIDER=local
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# 1 loyalty point = Rp 100 (integer sen)
LOYALTY_POINT_VALUE_CENTS=100

# --- Frontend (Vite; prefix VITE_ is exposed to the browser) ---
# Relative /api/v1 is preferred behind docker gateway (same-origin, no CORS hop).
# For local Vite dev against API on :9300 use: http://localhost:9300/api/v1
VITE_API_URL=/api/v1
VITE_DEPLOYMENT_MODE=cloud
VITE_DEFAULT_TENANT_SLUG=onprem-store
