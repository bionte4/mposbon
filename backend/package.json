{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"env -u APP_PORT node --env-file=.env dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "sh -c 'set -a && . ./.env && set +a && DATABASE_URL=\"$DATABASE_MIGRATE_URL\" npx prisma migrate deploy'",
    "prisma:migrate:dev": "sh -c 'set -a && . ./.env && set +a && DATABASE_URL=\"$DATABASE_MIGRATE_URL\" npx prisma migrate dev'",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/**/*.spec.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.16.0",
    "prisma": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
