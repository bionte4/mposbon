generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeploymentMode {
  CLOUD
  ONPREM
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

/// Shared-database multi-tenancy: one row per customer (SaaS) or the single
/// locked site (on-prem). Child tables carry tenant_id + RLS.
model Tenant {
  id               String           @id @default(uuid()) @db.Uuid
  slug             String           @unique
  name             String
  domain           String?
  status           TenantStatus     @default(ACTIVE)
  deploymentMode   DeploymentMode   @default(CLOUD) @map("deployment_mode")
  licenseKeyHash   String?          @map("license_key_hash")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  settings         TenantSetting?
  users            User[]
  stores           Store[]
  categories       Category[]
  products         Product[]
  carts            Cart[]
  cartItems        CartItem[]
  sales            Sale[]
  saleLines        SaleLine[]
  cashierShifts    CashierShift[]
  supervisorActions SupervisorAction[]
  employees        Employee[]
  workShifts       WorkShift[]
  attendances      Attendance[]
  payrollSlips     PayrollSlip[]
  dailySalesSummaries    DailySalesSummary[]
  dailyProductSummaries  DailyProductSummary[]
  activityLogs     ActivityLog[]
  customers        Customer[]
  productModifierGroups ProductModifierGroup[]
  productModifierOptions ProductModifierOption[]
  storeStocks      StoreStock[]
  storePrices      StorePrice[]
  edgeSyncOutbox   EdgeSyncOutbox[]
  edgeSyncCursors  EdgeSyncCursor[]
  cashDrawerMovements CashDrawerMovement[]
  salePayments     SalePayment[]
  stockTransfers   StockTransfer[]
  stockTransferLines StockTransferLine[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  goodsReceiptLines GoodsReceiptLine[]
  promos           Promo[]
  paymentCharges   PaymentCharge[]
  tableAreas       TableArea[]
  diningTables     DiningTable[]
  stockCountSessions StockCountSession[]
  stockCountLines  StockCountLine[]
  recipes          Recipe[]
  recipeLines      RecipeLine[]
  kitchenStations  KitchenStation[]
  kitchenOrders    KitchenOrder[]
  kitchenOrderLines KitchenOrderLine[]
  userKitchenStations UserKitchenStation[]
  productVariants     ProductVariant[]
  storeVariantStocks  StoreVariantStock[]
  glAccounts          GlAccount[]
  journalEntries      JournalEntry[]
  journalEntryLines   JournalEntryLine[]
  integrationApiKeys  IntegrationApiKey[]
  glAccountMappings   GlAccountMapping[]
  integrationWebhooks IntegrationWebhook[]
  integrationWebhookDeliveries IntegrationWebhookDelivery[]

  @@map("tenants")
}

model TenantSetting {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyCode     String   @default("IDR") @map("currency_code")
  timezone         String   @default("Asia/Jakarta")
  edgeSyncEnabled  Boolean  @default(false) @map("edge_sync_enabled")
  /// Public display name on login / receipt chrome (falls back to Tenant.name).
  brandName        String?  @map("brand_name")
  /// HTTPS (or same-origin) logo URL — paste CDN/S3 path; no media library required.
  logoUrl          String?  @map("logo_url")
  /// Optional hex accent for login chrome, e.g. #0f766e.
  accentColor      String?  @map("accent_color")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

enum StaffRole {
  CASHIER
  /// Floor kitchen/bar staff — KDS only (no POS/admin/HRIS). Scope via UserKitchenStation.
  KITCHEN
  SUPERVISOR
  MANAGER
  TENANT_ADMIN
  SUPER_ADMIN
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  displayName String    @map("display_name")
  role        StaffRole @default(CASHIER)
  /// scrypt hash "saltHex:hashHex" for supervisor/manager PIN. Never store plaintext.
  pinHash     String?   @map("pin_hash")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  carts       Cart[]
  sales       Sale[]
  shifts      CashierShift[]
  authorizedActions SupervisorAction[] @relation("SupervisorActor")
  requestedActions  SupervisorAction[] @relation("ActionRequester")
  employeeProfile   Employee?
  activityLogs      ActivityLog[]
  drawerMovements   CashDrawerMovement[] @relation("DrawerMovementActor")
  stockTransfers    StockTransfer[] @relation("StockTransferActor")
  purchaseOrders    PurchaseOrder[] @relation("PurchaseOrderActor")
  goodsReceipts     GoodsReceipt[] @relation("GoodsReceiptActor")
  stockCountSessions StockCountSession[] @relation("StockCountActor")
  stockCountCompleted StockCountSession[] @relation("StockCountCompleter")
  kitchenStations   UserKitchenStation[]
  integrationApiKeys IntegrationApiKey[] @relation("IntegrationApiKeyCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  address     String?
  phone       String?
  /// IANA timezone for receipts / local day boundaries (e.g. Asia/Jakarta).
  timezone    String   @default("Asia/Jakarta")
  receiptHeader String? @map("receipt_header") @db.Text
  receiptFooter String? @map("receipt_footer") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  /// Static QRIS MPM EMVCo payload (from bank/PSP). Shown as QR at checkout.
  qrisPayload String?  @map("qris_payload") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  carts     Cart[]
  sales     Sale[]
  shifts    CashierShift[]
  employees Employee[]
  dailySalesSummaries DailySalesSummary[]
  stocks    StoreStock[]
  prices    StorePrice[]
  edgeSyncOutbox EdgeSyncOutbox[]
  transfersFrom StockTransfer[] @relation("TransferFromStore")
  transfersTo   StockTransfer[] @relation("TransferToStore")
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  paymentCharges PaymentCharge[]
  tableAreas     TableArea[]
  diningTables   DiningTable[]
  stockCountSessions StockCountSession[]
  kitchenStations    KitchenStation[]
  kitchenOrders      KitchenOrder[]
  storeVariantStocks StoreVariantStock[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("stores")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SupervisorActionType {
  VOID_ITEM
  VOID_SALE
  REFUND_SALE
  MANUAL_DISCOUNT
  FORCE_OPEN_DRAWER
}

/// Cashier shift session: clock-in binds POS sales; clock-out produces Z-Report.
model CashierShift {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId              String      @map("store_id") @db.Uuid
  store                Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashierUserId        String      @map("cashier_user_id") @db.Uuid
  cashier              User        @relation(fields: [cashierUserId], references: [id], onDelete: Restrict)
  status               ShiftStatus @default(OPEN)
  clockInAt            DateTime    @map("clock_in_at")
  clockOutAt           DateTime?   @map("clock_out_at")
  /// Opening cash float in smallest currency units.
  openingFloatInCents  Int         @default(0) @map("opening_float_in_cents")
  cashSalesInCents     Int         @default(0) @map("cash_sales_in_cents")
  cardSalesInCents     Int         @default(0) @map("card_sales_in_cents")
  qrisSalesInCents     Int         @default(0) @map("qris_sales_in_cents")
  otherSalesInCents    Int         @default(0) @map("other_sales_in_cents")
  voidTotalInCents     Int         @default(0) @map("void_total_in_cents")
  /// Cash returned on void/refund of CASH tenders (integer sen).
  cashRefundsInCents   Int         @default(0) @map("cash_refunds_in_cents")
  /// Sum of mid-shift cash drops removed from drawer (integer sen).
  cashDropsInCents     Int         @default(0) @map("cash_drops_in_cents")
  discountTotalInCents Int         @default(0) @map("discount_total_in_cents")
  /// Gratuity collected on sales this shift (integer sen).
  tipsInCents          Int         @default(0) @map("tips_in_cents")
  saleCount            Int         @default(0) @map("sale_count")
  /// Expected drawer = openingFloat + cashSales - cashRefunds - cashDrops (integer).
  expectedCashInCents  Int?        @map("expected_cash_in_cents")
  countedCashInCents   Int?        @map("counted_cash_in_cents")
  discrepancyInCents   Int?        @map("discrepancy_in_cents")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  sales                Sale[]
  supervisorActions    SupervisorAction[]
  drawerMovements      CashDrawerMovement[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, cashierUserId, status])
  @@map("cashier_shifts")
}

enum CashDrawerMovementType {
  DROP
  MID_COUNT
}

/// Mid-shift cash drop or blind mid-count against the open drawer.
model CashDrawerMovement {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId          String                 @map("shift_id") @db.Uuid
  shift            CashierShift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type             CashDrawerMovementType
  /// DROP: cash removed from drawer. MID_COUNT: blind counted cash at that moment.
  amountInCents    Int                    @map("amount_in_cents")
  /// Snapshot of expected cash when the movement was recorded (hidden from cashier until after submit for MID_COUNT).
  expectedAtInCents Int                   @map("expected_at_in_cents")
  /// MID_COUNT only: counted - expectedAt (null for DROP).
  varianceInCents  Int?                   @map("variance_in_cents")
  note             String?
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdBy        User                   @relation("DrawerMovementActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now()) @map("created_at")

  @@index([tenantId, shiftId, createdAt])
  @@map("cash_drawer_movements")
}

/// Audit of sensitive POS actions that required supervisor PIN / elevated RBAC.
model SupervisorAction {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId         String?               @map("shift_id") @db.Uuid
  shift           CashierShift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  actionType      SupervisorActionType  @map("action_type")
  requesterUserId String                @map("requester_user_id") @db.Uuid
  requester       User                  @relation("ActionRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  supervisorUserId String               @map("supervisor_user_id") @db.Uuid
  supervisor      User                  @relation("SupervisorActor", fields: [supervisorUserId], references: [id], onDelete: Restrict)
  saleId          String?               @map("sale_id") @db.Uuid
  amountInCents   Int?                  @map("amount_in_cents")
  reason          String?
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("supervisor_actions")
}

enum ActivityAction {
  VOID_SALE
  VOID_ITEM
  REFUND_SALE
  MANUAL_DISCOUNT
  MANUAL_PRICE_OVERRIDE
  REMOVE_CART_ITEM
  FORCE_OPEN_DRAWER
  SUPERVISOR_PIN_OK
  SUPERVISOR_PIN_FAIL
  SHIFT_CLOCK_IN
  SHIFT_CLOCK_OUT
  ADMIN_CATALOG_CHANGE
  CASH_DROP
  MID_COUNT
  STOCK_TRANSFER
  STOCK_ADJUST
  PURCHASE_ORDER
  GOODS_RECEIPT
  PROMO_APPLY
  LOYALTY_REDEEM
  PAYMENT_CHARGE
  STOCK_COUNT
  KITCHEN_FIRE
  RECIPE_CONSUME
  JOURNAL_POST
  GL_ACCOUNT_CHANGE
}

/// Immutable activity / audit trail for sensitive POS & auth events.
model ActivityLog {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId     String?        @map("actor_user_id") @db.Uuid
  actor           User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action          ActivityAction
  entityType      String?        @map("entity_type")
  entityId        String?        @map("entity_id")
  amountInCents   Int?           @map("amount_in_cents")
  reason          String?
  ipAddress       String?        @map("ip_address")
  userAgent       String?        @map("user_agent")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("activity_logs")
}

enum CartStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QRIS
  OTHER
  SPLIT
}

/// Monetary columns are INTEGER smallest currency units (IDR rupiah / sen). Never float.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  promos    Promo[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

enum ProductType {
  RETAIL
  MENU
  INGREDIENT
}

model Product {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String     @map("category_id") @db.Uuid
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sku             String
  barcode         String?
  name            String
  productType     ProductType @default(RETAIL) @map("product_type")
  /// Optional KDS routing — items with a station are fired to kitchen display.
  kitchenStationId String?   @map("kitchen_station_id") @db.Uuid
  kitchenStation  KitchenStation? @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  /// Unit selling price in smallest currency unit (e.g. Rp 15.000 → 15000).
  unitPriceInCents Int       @map("unit_price_in_cents")
  /// Tax in basis points (1100 = 11%). Integer rate; line tax is computed as integer sen.
  taxBps          Int        @default(0) @map("tax_bps")
  stockQty        Int        @default(0) @map("stock_qty")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  cartItems       CartItem[]
  saleLines       SaleLine[]
  dailyProductSummaries DailyProductSummary[]
  modifierGroups  ProductModifierGroup[]
  storeStocks     StoreStock[]
  storePrices     StorePrice[]
  transferLines   StockTransferLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  promos             Promo[]
  stockCountLines    StockCountLine[]
  recipe             Recipe?
  recipeAsIngredient RecipeLine[] @relation("RecipeIngredient")
  kitchenOrderLines  KitchenOrderLine[]
  variants           ProductVariant[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("products")
}

/// Stock-tracked sellable SKU under a parent product (size/color/pack). Distinct from modifiers.
model ProductVariant {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId        String   @map("product_id") @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  barcode          String?
  /// Absolute unit price in sen (overrides parent when selected).
  unitPriceInCents Int      @map("unit_price_in_cents")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  storeStocks      StoreVariantStock[]
  cartItems        CartItem[]
  saleLines        SaleLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId, sortOrder])
  @@map("product_variants")
}

/// Per-outlet on-hand for a variant SKU.
model StoreVariantStock {
  tenantId  String         @map("tenant_id") @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId   String         @map("store_id") @db.Uuid
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int            @default(0)
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@id([tenantId, storeId, variantId])
  @@index([tenantId, storeId])
  @@map("store_variant_stocks")
}

/// Per-outlet on-hand quantity. Product.stockQty remains the catalog default / fallback.
model StoreStock {
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, storeId, productId])
  @@index([tenantId, storeId])
  @@map("store_stocks")
}

/// Optional per-outlet list price. Null row → use Product.unitPriceInCents.
model StorePrice {
  tenantId         String  @map("tenant_id") @db.Uuid
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId          String  @map("store_id") @db.Uuid
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String  @map("product_id") @db.Uuid
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPriceInCents Int     @map("unit_price_in_cents")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@id([tenantId, storeId, productId])
  @@index([tenantId, storeId])
  @@map("store_prices")
}

/// Durable outbox for edge↔hub async sync (on-prem / unstable network).
model EdgeSyncOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId     String?   @map("store_id") @db.Uuid
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  payload     Json
  availableAt DateTime  @default(now()) @map("available_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, availableAt])
  @@index([tenantId, deliveredAt])
  @@map("edge_sync_outbox")
}

model EdgeSyncCursor {
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stream    String
  cursor    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, stream])
  @@map("edge_sync_cursors")
}

/// Optional add-on groups on a product (size, toppings). Not stock-tracked variants.
model ProductModifierGroup {
  id        String                  @id @default(uuid()) @db.Uuid
  tenantId  String                  @map("tenant_id") @db.Uuid
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String                  @map("product_id") @db.Uuid
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int                     @default(0) @map("min_select")
  maxSelect Int                     @default(1) @map("max_select")
  sortOrder Int                     @default(0) @map("sort_order")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  options   ProductModifierOption[]

  @@index([tenantId, productId])
  @@map("product_modifier_groups")
}

model ProductModifierOption {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId          String              @map("group_id") @db.Uuid
  group            ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name             String
  /// Additive to unit price in integer sen. May be 0.
  priceDeltaInCents Int                @default(0) @map("price_delta_in_cents")
  isActive         Boolean             @default(true) @map("is_active")
  sortOrder        Int                 @default(0) @map("sort_order")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([tenantId, groupId])
  @@map("product_modifier_options")
}

/// Retail customer profile (omnichannel-ready). Separate from staff User.
model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  notes         String?
  /// Loyalty points (integer). Earn on completed sales; never float.
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  carts         Cart[]
  sales         Sale[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId        String     @map("store_id") @db.Uuid
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashierUserId  String?    @map("cashier_user_id") @db.Uuid
  cashier        User?      @relation(fields: [cashierUserId], references: [id], onDelete: SetNull)
  customerId     String?    @map("customer_id") @db.Uuid
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         CartStatus @default(OPEN)
  /// Optional hold label (table / name) for parked orders.
  label          String?
  /// F&B dine-in table assignment (Moka-style floor plan).
  tableId        String?    @map("table_id") @db.Uuid
  table          DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  parkedAt       DateTime?  @map("parked_at")
  /// Client UUID so an offline cart can be upserted without duplicates.
  clientUuid     String     @map("client_uuid")
  subtotalInCents Int       @default(0) @map("subtotal_in_cents")
  taxInCents     Int        @default(0) @map("tax_in_cents")
  totalInCents   Int        @default(0) @map("total_in_cents")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  items          CartItem[]
  sale           Sale?

  @@unique([tenantId, clientUuid])
  @@index([tenantId, storeId, status])
  @@index([tenantId, tableId, status])
  @@map("carts")
}

model CartItem {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cartId             String   @map("cart_id") @db.Uuid
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String   @map("product_id") @db.Uuid
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId          String?  @map("variant_id") @db.Uuid
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName        String   @map("product_name")
  quantity           Int
  unitPriceInCents   Int      @map("unit_price_in_cents")
  taxBps             Int      @map("tax_bps")
  taxInCents         Int      @map("tax_in_cents")
  lineSubtotalInCents Int     @map("line_subtotal_in_cents")
  lineTotalInCents   Int      @map("line_total_in_cents")
  /// Snapshot of selected modifiers [{optionId,name,priceDeltaInCents}]
  modifiersJson      Json?    @map("modifiers_json")
  /// Guest / seat index for bill split (1-based). Default 1 = single check.
  guestIndex         Int      @default(1) @map("guest_index")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([tenantId, cartId])
  @@index([tenantId, variantId])
  @@map("cart_items")
}

model Sale {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId          String        @map("store_id") @db.Uuid
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashierUserId    String?       @map("cashier_user_id") @db.Uuid
  cashier          User?         @relation(fields: [cashierUserId], references: [id], onDelete: SetNull)
  shiftId          String?       @map("shift_id") @db.Uuid
  shift            CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cartId           String?       @unique @map("cart_id") @db.Uuid
  cart             Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customerId       String?       @map("customer_id") @db.Uuid
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status           SaleStatus    @default(COMPLETED)
  paymentMethod    PaymentMethod @map("payment_method")
  subtotalInCents  Int           @map("subtotal_in_cents")
  taxInCents       Int           @map("tax_in_cents")
  discountInCents  Int           @default(0) @map("discount_in_cents")
  /// Gratuity / tip paid by customer (integer sen). Included in totalInCents.
  tipInCents       Int           @default(0) @map("tip_in_cents")
  totalInCents     Int           @map("total_in_cents")
  /// Points awarded on this sale (integer).
  loyaltyPointsEarned Int        @default(0) @map("loyalty_points_earned")
  /// Points redeemed for discount on this sale (integer).
  loyaltyPointsRedeemed Int      @default(0) @map("loyalty_points_redeemed")
  /// Optional promo that produced (part of) discountInCents.
  promoId          String?       @map("promo_id") @db.Uuid
  promo            Promo?        @relation(fields: [promoId], references: [id], onDelete: SetNull)
  /// Snapshot of voucher / promo code at sale time.
  promoCode        String?       @map("promo_code")
  /// Wall-clock on the cashier device (offline). Used later for conflict ordering.
  clientCreatedAt  DateTime      @map("client_created_at")
  syncedAt         DateTime      @default(now()) @map("synced_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  lines            SaleLine[]
  payments         SalePayment[]
  paymentCharges   PaymentCharge[]

  @@index([tenantId, storeId, clientCreatedAt])
  @@index([tenantId, shiftId])
  @@index([tenantId, customerId])
  @@index([tenantId, promoId])
  /// Dashboard / ops: filter completed sales by day without seq-scan.
  @@index([tenantId, status, clientCreatedAt])
  @@map("sales")
}

/// Split-tender lines for a sale. Sum(amountInCents) must equal Sale.totalInCents.
model SalePayment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId         String        @map("sale_id") @db.Uuid
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Must not be SPLIT — each row is a concrete tender.
  paymentMethod  PaymentMethod @map("payment_method")
  amountInCents  Int           @map("amount_in_cents")
  /// Optional cash tendered for change calc on CASH lines.
  amountTenderedInCents Int?   @map("amount_tendered_in_cents")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([tenantId, saleId])
  @@map("sale_payments")
}

model SaleLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId              String   @map("sale_id") @db.Uuid
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId           String   @map("product_id") @db.Uuid
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?  @map("variant_id") @db.Uuid
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName         String   @map("product_name")
  quantity            Int
  unitPriceInCents    Int      @map("unit_price_in_cents")
  taxBps              Int      @map("tax_bps")
  taxInCents          Int      @map("tax_in_cents")
  lineSubtotalInCents Int      @map("line_subtotal_in_cents")
  lineTotalInCents    Int      @map("line_total_in_cents")
  modifiersJson       Json?    @map("modifiers_json")
  guestIndex          Int      @default(1) @map("guest_index")
  /// HPP / COGS snapshot (integer sen) from recipe BOM at sale time.
  cogsInCents         Int      @default(0) @map("cogs_in_cents")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("sale_lines")
}

// ---------------------------------------------------------------------------
// Recipe / BOM — menu item → ingredient consumption + HPP (Odoo-style).
// ---------------------------------------------------------------------------

model Recipe {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String       @unique @map("product_id") @db.Uuid
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Output qty per batch (usually 1 serving).
  yieldQty  Int          @default(1) @map("yield_qty")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  lines     RecipeLine[]

  @@index([tenantId])
  @@map("recipes")
}

model RecipeLine {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeId           String   @map("recipe_id") @db.Uuid
  recipe             Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String  @map("ingredient_product_id") @db.Uuid
  ingredient         Product  @relation("RecipeIngredient", fields: [ingredientProductId], references: [id], onDelete: Restrict)
  /// Ingredient qty consumed per recipe yield (integer units).
  qty                Int
  /// Unit cost in sen for HPP calc (editable; refresh from last PO receive).
  unitCostInCents    Int      @default(0) @map("unit_cost_in_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, recipeId, ingredientProductId])
  @@index([tenantId, recipeId])
  @@map("recipe_lines")
}

// ---------------------------------------------------------------------------
// Kitchen Display System (KDS) — station routing + ticket bump workflow.
// ---------------------------------------------------------------------------

model KitchenStation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products  Product[]
  orderLines KitchenOrderLine[]
  staffAssignments UserKitchenStation[]

  @@unique([tenantId, storeId, code])
  @@index([tenantId, storeId, sortOrder])
  @@map("kitchen_stations")
}

/// Assigns KDS staff to one or more stations (BAR / KITCHEN / …) within a store.
model UserKitchenStation {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String         @map("station_id") @db.Uuid
  station   KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([userId, stationId])
  @@index([tenantId, userId])
  @@index([tenantId, stationId])
  @@map("user_kitchen_stations")
}

enum KitchenOrderStatus {
  OPEN
  DONE
  CANCELLED
}

enum KitchenLineStatus {
  PENDING
  PREPARING
  READY
  DONE
  CANCELLED
}

model KitchenOrder {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId        String             @map("store_id") @db.Uuid
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cartClientUuid String             @map("cart_client_uuid")
  tableLabel     String?            @map("table_label")
  status         KitchenOrderStatus @default(OPEN)
  saleId         String?            @map("sale_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  lines          KitchenOrderLine[]

  @@index([tenantId, storeId, status, createdAt])
  @@index([tenantId, cartClientUuid, status])
  @@map("kitchen_orders")
}

model KitchenOrderLine {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId        String            @map("order_id") @db.Uuid
  order          KitchenOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId      String            @map("station_id") @db.Uuid
  station        KitchenStation    @relation(fields: [stationId], references: [id], onDelete: Restrict)
  productId      String            @map("product_id") @db.Uuid
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String            @map("product_name")
  quantity       Int
  modifiersJson  Json?             @map("modifiers_json")
  guestIndex     Int               @default(1) @map("guest_index")
  /// Client-side line key for idempotent fire (cart item id).
  clientLineId   String            @map("client_line_id")
  status         KitchenLineStatus @default(PENDING)
  firedAt        DateTime          @default(now()) @map("fired_at")
  readyAt        DateTime?         @map("ready_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, orderId, clientLineId])
  @@index([tenantId, stationId, status, firedAt])
  @@map("kitchen_order_lines")
}

enum StockTransferStatus {
  /// Created, stock not yet removed from source.
  DRAFT
  /// Shipped: source decremented; goods not yet at destination.
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// Inter-store stock move. Prefer ship → in-transit → receive; `immediate` still supported.
model StockTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromStoreId     String              @map("from_store_id") @db.Uuid
  fromStore       Store               @relation("TransferFromStore", fields: [fromStoreId], references: [id], onDelete: Restrict)
  toStoreId       String              @map("to_store_id") @db.Uuid
  toStore         Store               @relation("TransferToStore", fields: [toStoreId], references: [id], onDelete: Restrict)
  status          StockTransferStatus @default(DRAFT)
  note            String?
  shippedAt       DateTime?           @map("shipped_at")
  receivedAt      DateTime?           @map("received_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdBy       User                @relation("StockTransferActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  lines           StockTransferLine[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, fromStoreId])
  @@index([tenantId, toStoreId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferId  String        @map("transfer_id") @db.Uuid
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty         Int
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, transferId])
  @@map("stock_transfer_lines")
}

// ---------------------------------------------------------------------------
// Purchasing / Receiving — supplier PO → goods receipt → store stock inbound
// All costs are INTEGER sen. Receiving may be partial across multiple GRs.
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

/// Purchase order header. Default receive store can be overridden at GR time.
model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId      String              @map("supplier_id") @db.Uuid
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Preferred / default store for receiving.
  storeId         String              @map("store_id") @db.Uuid
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  code            String
  status          PurchaseOrderStatus @default(DRAFT)
  note            String?
  /// Sum of line totals (qtyOrdered * unitCost) in integer sen.
  subtotalInCents Int                 @default(0) @map("subtotal_in_cents")
  orderedAt       DateTime?           @map("ordered_at")
  receivedAt      DateTime?           @map("received_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdBy       User                @relation("PurchaseOrderActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  lines           PurchaseOrderLine[]
  receipts        GoodsReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, supplierId])
  @@index([tenantId, storeId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  qtyOrdered      Int           @map("qty_ordered")
  qtyReceived     Int           @default(0) @map("qty_received")
  /// Unit purchase cost in integer sen (never float).
  unitCostInCents Int           @map("unit_cost_in_cents")
  /// qtyOrdered * unitCostInCents (integer).
  lineTotalInCents Int          @map("line_total_in_cents")
  createdAt       DateTime      @default(now()) @map("created_at")
  receiptLines    GoodsReceiptLine[]

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, productId])
  @@map("purchase_order_lines")
}

/// Goods receipt (inbound) against a PO — may be partial; each GR bumps store stock.
model GoodsReceipt {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String            @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  storeId         String            @map("store_id") @db.Uuid
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  code            String
  note            String?
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdBy       User              @relation("GoodsReceiptActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now()) @map("created_at")
  lines           GoodsReceiptLine[]

  @@unique([tenantId, code])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, storeId, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goodsReceiptId      String            @map("goods_receipt_id") @db.Uuid
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String            @map("purchase_order_line_id") @db.Uuid
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  productId           String            @map("product_id") @db.Uuid
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty                 Int
  /// Snapshot of PO line unit cost at receive time (integer sen).
  unitCostInCents     Int               @map("unit_cost_in_cents")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([tenantId, goodsReceiptId])
  @@index([tenantId, purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

// ---------------------------------------------------------------------------
// Promotions — voucher / automatic discount (integer sen or bps). Never float.
// ---------------------------------------------------------------------------

enum PromoType {
  PERCENT
  FIXED
}

enum PromoScope {
  ALL
  CATEGORY
  PRODUCT
}

model Promo {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Voucher code (uppercase). Unique per tenant when set.
  code               String
  name               String
  type               PromoType
  scope              PromoScope @default(ALL)
  /// PERCENT: rate in basis points (1000 = 10%). Null for FIXED.
  percentBps         Int?       @map("percent_bps")
  /// FIXED: flat discount in integer sen. Null for PERCENT.
  amountInCents      Int?       @map("amount_in_cents")
  /// Cap for PERCENT discounts (integer sen).
  maxDiscountInCents Int?       @map("max_discount_in_cents")
  /// Minimum cart subtotal+tax before promo applies.
  minSubtotalInCents Int        @default(0) @map("min_subtotal_in_cents")
  categoryId         String?    @map("category_id") @db.Uuid
  category           Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId          String?    @map("product_id") @db.Uuid
  product            Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  startsAt           DateTime?  @map("starts_at")
  endsAt             DateTime?  @map("ends_at")
  usageLimit         Int?       @map("usage_limit")
  usedCount          Int        @default(0) @map("used_count")
  isActive           Boolean    @default(true) @map("is_active")
  /// When false, loyalty redeem cannot stack on the same sale.
  stackWithLoyalty   Boolean    @default(true) @map("stack_with_loyalty")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  sales              Sale[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, startsAt, endsAt])
  @@map("promos")
}

// ---------------------------------------------------------------------------
// Payment charges — Midtrans / Xendit QRIS (or local static QR fallback).
// ---------------------------------------------------------------------------

enum PaymentProvider {
  LOCAL_QRIS
  MIDTRANS
  XENDIT
}

enum PaymentChargeStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

model PaymentCharge {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId         String              @map("store_id") @db.Uuid
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// Linked after POS sale sync when payment settles.
  saleId          String?             @map("sale_id") @db.Uuid
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  /// Cart client UUID so cashier can poll before sale id exists.
  clientUuid      String              @map("client_uuid")
  provider        PaymentProvider
  status          PaymentChargeStatus @default(PENDING)
  amountInCents   Int                 @map("amount_in_cents")
  /// Provider order / charge id (unique per tenant when set).
  providerRef     String?             @map("provider_ref")
  /// QRIS MPM string from PSP (or echoed local dynamic payload).
  qrString        String?             @map("qr_string") @db.Text
  deeplinkUrl     String?             @map("deeplink_url")
  expiresAt       DateTime?           @map("expires_at")
  paidAt          DateTime?           @map("paid_at")
  rawWebhook      Json?               @map("raw_webhook")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, providerRef])
  @@index([tenantId, clientUuid, status])
  @@index([tenantId, storeId, createdAt])
  @@index([tenantId, saleId])
  @@map("payment_charges")
}

// ---------------------------------------------------------------------------
// F&B table management — floor areas + dine-in tables (Moka-style).
// Table status is derived from OPEN carts linked via Cart.tableId.
// ---------------------------------------------------------------------------

model TableArea {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId   String        @map("store_id") @db.Uuid
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tables    DiningTable[]

  @@index([tenantId, storeId, sortOrder])
  @@map("table_areas")
}

model DiningTable {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId   String     @map("store_id") @db.Uuid
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  areaId    String?    @map("area_id") @db.Uuid
  area      TableArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  code      String
  name      String
  capacity  Int        @default(4)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  carts     Cart[]

  @@unique([tenantId, storeId, code])
  @@index([tenantId, storeId, areaId, sortOrder])
  @@map("dining_tables")
}

// ---------------------------------------------------------------------------
// Stock opname — formal count session with variance → store stock adjust.
// ---------------------------------------------------------------------------

enum StockCountStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model StockCountSession {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId            String           @map("store_id") @db.Uuid
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  code               String
  status             StockCountStatus @default(DRAFT)
  note               String?
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdBy          User             @relation("StockCountActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedByUserId  String?          @map("completed_by_user_id") @db.Uuid
  completedBy        User?            @relation("StockCountCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  lines              StockCountLine[]

  @@unique([tenantId, code])
  @@index([tenantId, storeId, status, createdAt])
  @@map("stock_count_sessions")
}

model StockCountLine {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId       String            @map("session_id") @db.Uuid
  session         StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId       String            @map("product_id") @db.Uuid
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSku      String            @map("product_sku")
  productName     String            @map("product_name")
  /// Snapshot of system on-hand at session start (integer units).
  systemQty       Int               @map("system_qty")
  /// Physical count entered by staff (null until counted).
  countedQty      Int?              @map("counted_qty")
  /// countedQty - systemQty after complete (integer).
  varianceQty     Int?              @map("variance_qty")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, sessionId, productId])
  @@index([tenantId, sessionId])
  @@map("stock_count_lines")
}

// ---------------------------------------------------------------------------
// HRIS — employees, scheduled work shifts, attendance, payroll slips
// Monetary fields are INTEGER smallest currency units. Never float.
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

/// PTKP category reference for Indonesian PPh 21 annual non-taxable income.
enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HALF_DAY
}

enum PayrollSlipStatus {
  DRAFT
  FINALIZED
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Optional link to POS login user (cashier account).
  userId             String?        @unique @map("user_id") @db.Uuid
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  storeId            String?        @map("store_id") @db.Uuid
  store              Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  employeeCode       String         @map("employee_code")
  fullName           String         @map("full_name")
  email              String?
  phone              String?
  hireDate           DateTime       @map("hire_date") @db.Date
  status             EmployeeStatus @default(ACTIVE)
  /// Monthly base salary in smallest currency units (IDR rupiah).
  baseSalaryInCents  Int            @map("base_salary_in_cents")
  ptkpStatus         PtkpStatus     @default(TK0) @map("ptkp_status")
  workShiftId        String?        @map("work_shift_id") @db.Uuid
  workShift          WorkShift?     @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  attendances        Attendance[]
  payrollSlips       PayrollSlip[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@map("employees")
}

/// Scheduled work shift template (pagi / malam), distinct from POS CashierShift sessions.
model WorkShift {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  name             String
  /// Minutes from midnight local time (e.g. 08:00 → 480).
  startMinutes     Int        @map("start_minutes")
  endMinutes       Int        @map("end_minutes")
  breakMinutes     Int        @default(60) @map("break_minutes")
  /// Standard paid minutes after break (computed/stored for clarity).
  standardMinutes  Int        @map("standard_minutes")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  employees        Employee[]
  attendances      Attendance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_shifts")
}

model Attendance {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String           @map("employee_id") @db.Uuid
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workShiftId        String?          @map("work_shift_id") @db.Uuid
  workShift          WorkShift?       @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  /// Optional link when attendance is derived from a POS cashier shift.
  cashierShiftId     String?          @map("cashier_shift_id") @db.Uuid
  workDate           DateTime         @map("work_date") @db.Date
  clockInAt          DateTime?        @map("clock_in_at")
  clockOutAt         DateTime?        @map("clock_out_at")
  status             AttendanceStatus @default(PRESENT)
  scheduledMinutes   Int              @default(0) @map("scheduled_minutes")
  workedMinutes      Int              @default(0) @map("worked_minutes")
  overtimeMinutes    Int              @default(0) @map("overtime_minutes")
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, workDate])
  @@map("attendances")
}

model PayrollSlip {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId            String            @map("employee_id") @db.Uuid
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodYear            Int               @map("period_year")
  periodMonth           Int               @map("period_month")
  status                PayrollSlipStatus @default(DRAFT)
  baseSalaryInCents     Int               @map("base_salary_in_cents")
  overtimePayInCents    Int               @default(0) @map("overtime_pay_in_cents")
  grossInCents          Int               @map("gross_in_cents")
  /// Monthly PPh 21 withholding (integer sen).
  pph21InCents          Int               @default(0) @map("pph21_in_cents")
  netInCents            Int               @map("net_in_cents")
  overtimeMinutes       Int               @default(0) @map("overtime_minutes")
  presentDays           Int               @default(0) @map("present_days")
  /// Opaque breakdown from PayrollService (brackets, PTKP, OT rates).
  breakdown             Json?
  calculatedAt          DateTime          @default(now()) @map("calculated_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, periodYear, periodMonth])
  @@index([tenantId, periodYear, periodMonth])
  @@map("payroll_slips")
}

// ---------------------------------------------------------------------------
// Analytics summary tables — dashboard reads these so peak-hour POS ops
// are not hit with heavy GROUP BY on sales / sale_lines.
// Updated incrementally on sale sync / void within the same tenant TX.
// ---------------------------------------------------------------------------

model DailySalesSummary {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId            String   @map("store_id") @db.Uuid
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Calendar day in tenant local intent (UTC date stored as DATE).
  summaryDate        DateTime @map("summary_date") @db.Date
  /// Gross = sum(subtotal + tax) before discount/void adjustments tracked separately.
  grossSalesInCents  Int      @default(0) @map("gross_sales_in_cents")
  discountInCents    Int      @default(0) @map("discount_in_cents")
  voidInCents        Int      @default(0) @map("void_in_cents")
  /// Net = gross - discount - void (integer).
  netSalesInCents    Int      @default(0) @map("net_sales_in_cents")
  transactionCount   Int      @default(0) @map("transaction_count")
  cashInCents        Int      @default(0) @map("cash_in_cents")
  cardInCents        Int      @default(0) @map("card_in_cents")
  qrisInCents        Int      @default(0) @map("qris_in_cents")
  otherInCents       Int      @default(0) @map("other_in_cents")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, storeId, summaryDate])
  @@index([tenantId, summaryDate])
  @@map("daily_sales_summaries")
}

model DailyProductSummary {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId           String   @map("store_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName       String   @map("product_name")
  summaryDate       DateTime @map("summary_date") @db.Date
  quantitySold      Int      @default(0) @map("quantity_sold")
  revenueInCents    Int      @default(0) @map("revenue_in_cents")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([tenantId, storeId, productId, summaryDate])
  @@index([tenantId, summaryDate, quantitySold])
  @@map("daily_product_summaries")
}

// ---------------------------------------------------------------------------
// Light GL — chart of accounts + posted journal entries (Accurate/Jurnal-ready).
// All amounts INTEGER sen. Entries must balance (sum debit == sum credit).
// ---------------------------------------------------------------------------

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalSourceType {
  SALE
  TRANSFER
  STOCK_COUNT
  GOODS_RECEIPT
  MANUAL
}

model GlAccount {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      GlAccountType
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  lines     JournalEntryLine[]
  mappings  GlAccountMapping[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("gl_accounts")
}

model JournalEntry {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType JournalSourceType @map("source_type")
  sourceId   String            @map("source_id")
  memo       String?
  postedAt   DateTime          @default(now()) @map("posted_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  lines      JournalEntryLine[]

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, postedAt])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId        String       @map("entry_id") @db.Uuid
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id") @db.Uuid
  account        GlAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountCode    String       @map("account_code")
  debitInCents   Int          @default(0) @map("debit_in_cents")
  creditInCents  Int          @default(0) @map("credit_in_cents")
  memo           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, entryId])
  @@index([tenantId, accountCode])
  @@map("journal_entry_lines")
}

/// Machine credentials for finance / GL partners (Accurate, Jurnal, custom ERP).
/// Secret is shown once at creation; only `keyHash` is stored.
model IntegrationApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  /// Public prefix for lookup, e.g. bp_live_ab12cd34
  keyPrefix       String    @map("key_prefix")
  keyHash         String    @map("key_hash")
  /// Permission strings, e.g. admin.finance.read
  scopes          String[]
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdBy       User?     @relation("IntegrationApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, keyPrefix])
  @@index([tenantId, revokedAt])
  @@map("integration_api_keys")
}

enum GlExternalProvider {
  ACCURATE
  JURNAL
  XERO
  QUICKBOOKS
  CUSTOM
}

/// Maps BonPOS GL codes → external finance system account IDs.
model GlAccountMapping {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           GlExternalProvider
  glAccountId        String             @map("gl_account_id") @db.Uuid
  glAccount          GlAccount          @relation(fields: [glAccountId], references: [id], onDelete: Cascade)
  accountCode        String             @map("account_code")
  externalAccountId  String             @map("external_account_id")
  externalAccountName String?           @map("external_account_name")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, provider, glAccountId])
  @@unique([tenantId, provider, accountCode])
  @@index([tenantId, provider])
  @@map("gl_account_mappings")
}

model IntegrationWebhook {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  /// e.g. journal.posted, account.updated
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deliveries IntegrationWebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("integration_webhooks")
}

model IntegrationWebhookDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookId    String    @map("webhook_id") @db.Uuid
  webhook      IntegrationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payloadJson  Json      @map("payload_json")
  statusCode   Int?      @map("status_code")
  success      Boolean   @default(false)
  errorMessage String?   @map("error_message")
  attempts     Int       @default(0)
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId, webhookId, createdAt])
  @@index([tenantId, success, createdAt])
  @@map("integration_webhook_deliveries")
}
